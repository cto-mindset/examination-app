{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "exam-app",
  "version": "0.2.0",
  "identifier": "uz.pigeon.exam-app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Examination App",
        "width": 800,
        "height": 700,
        "minWidth": 800,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3RTQ4NTA1RUQyMzM0QkIKUldTN05DUHRCWVhraDFBWWc1MTBOcGJsYmU4SitqVFRnNjVKL3cxalZiS0hjY21aMjk5MTJEVHUK",
      "endpoints": [
        "https://github.com/cto-mindset/examination-app/releases/latest/download/latest.json"
      ]
    }
  }
}